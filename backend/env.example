# 飞书应用配置 访问 https://open.feishu.cn
# 请按照配置指南获取以下信息并填入

# 飞书应用的 App ID（必填）
LARK_APP_ID=cli_a9a41eda3e38dbd1

# 飞书应用的 App Secret（必填）
LARK_APP_SECRET=T9JRlRE5X5peSTTrTTJHAgFfOEYbX2Wg

# 飞书多维表格的 App Token（必填）
# 获取方式：打开多维表格 -> 右上角"..." -> 复制链接 -> 从URL中提取 app_token
LARK_BITABLE_APP_TOKEN=Lxr0bELQtaJ6edseymbc4mwAn2g

# 飞书多维表格的 Table ID（必填）
# 获取方式：打开多维表格 -> 查看浏览器URL -> 从URL中提取 table_id
LARK_BITABLE_TABLE_ID=tblmBevuDBo9sClp

# 后端服务端口（可选，默认4004）
PORT=4004

# -------------------------------
# 腾讯云对象存储（COS）配置（新增）
# 请在腾讯云控制台获取 SecretId / SecretKey 并填写
# -------------------------------
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-chengdu                 # 默认区域，可按需修改
COS_BUCKET_NAME=jiaoanshenpi-1329644535  # 你的 COS 存储桶名称
# 如需自定义基础 URL，请取消下一行注释
# COS_BASE_URL=https://jiaoanshenpi-1329644535.cos.ap-chengdu.myqcloud.com

# 魔搭社区API配置 https://modelscope.cn/my/myaccesstoken

# API密钥（单个或多个，多个用逗号分隔）
MODELSCOPE_API_KEY=ms-c6713da0-f31a-4fdb-8102-4e3b37144e53,ms-b6636b12-02d2-4d7c-808e-14baa9537e86,ms-41bf827c-a555-40ca-98a6-2a89defa0e2d,ms-edcb3b36-9df2-49dc-8604-f1ee23bd1e7d
# API基础URL（可选，默认使用魔搭社区官方API）
MODELSCOPE_API_BASE=https://api-inference.modelscope.cn/v1

# 模型名称（可选，多个模型用逗号分隔，用于自动切换）
# 默认模型：Qwen/Qwen3-235B-A22B-Instruct-2507
MODELSCOPE_TEXT_MODELS=Qwen/Qwen3-235B-A22B-Instruct-2507,Qwen/Qwen3-Next-80B-A3B-Instruct,deepseek-ai/DeepSeek-V3.2
